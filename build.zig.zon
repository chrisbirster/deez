.{
    .name = .deez,
    .version = "0.0.0",
    .fingerprint = 0x7346b143bccbdc12, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // During Bongo dogfooding both repositories live as siblings. Pin this
        // to the released Bongo URL/hash before the Deez Mongo backend is
        // promoted from experimental to a normal release dependency.
        .bongo = .{
            .path = "../bongo",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
